# ========================================================
# CampusHub 3.0 (MERN Stack) - Environment Configuration
# Copy this file to .env and configure with your credentials.
# ========================================================

# Server Port (Render and cloud hosts will assign process.env.PORT automatically)
PORT=3000

# Application Environment (development or production)
NODE_ENV=development

# MongoDB Atlas Connection String
# Obtain from MongoDB Atlas -> Cluster -> Connect -> Drivers -> Node.js
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/campushub?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string

# Session Secret (Use a strong, random secret key)
SESSION_SECRET=replace_with_a_long_random_secret

# Initial Admin Credentials (Created automatically on first database connection)
ADMIN_NAME=Campus Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
